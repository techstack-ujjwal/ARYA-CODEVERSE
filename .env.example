# Server Configuration
PROJECT_NAME="AI Hackathon Evaluation Engine"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:3000","http://127.0.0.1:8000"]

# Database (PostgreSQL / Supabase with pgvector)
# For local dev / test: postgresql+asyncpg://postgres:postgres@localhost:5432/eval_engine (or sqlite+aiosqlite)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/eval_engine"
SYNC_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/eval_engine"


# Clerk Auth
CLERK_SECRET_KEY="sk_test_..."
CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_WEBHOOK_SECRET="whsec_..."
CLERK_JWKS_URL=""
CLERK_ISSUER=""

# LLM Providers
OPENAI_API_KEY=""
GOOGLE_API_KEY=""

# Tools & APIs
TAVILY_API_KEY=""
SERPAPI_KEY=""
GITHUB_TOKEN=""

# Supabase Storage & Vector
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Observability
LANGSMITH_TRACING="false"
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_API_KEY=""
LANGSMITH_PROJECT="hackathon-eval-engine"
SENTRY_DSN=""
